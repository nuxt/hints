{
  "name": "@nuxt/hints",
  "version": "1.1.5",
  "description": "Nuxt module that shows hints for aspects of your application such as Performance, Security, and more!",
  "repository": "https://github.com/nuxt/hints",
  "homepage": "https://github.com/nuxt/hints",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime/*": {
      "types": "./dist/runtime/*",
      "import": "./dist/runtime/*"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "client:build": "nuxi generate client",
    "client:dev": "nuxi dev client --port 3300",
    "prepack": "nuxt-module-build && pnpm run client:build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxi prepare && nuxi prepare playground",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && changelogen --release && pnpm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:types": "tsc --noEmit",
    "test:watch": "vitest watch",
    "cleanup": "rimraf **/node_modules **/dist **/.output **/.nuxt --glob"
  },
  "dependencies": {
    "@nuxt/devtools-kit": "^3.4.3",
    "@nuxt/kit": "^4.6.1",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "devalue": "^5.9.4",
    "h3": "^1.15.11",
    "html-validate": "^11.16.2",
    "knitwork": "^1.3.0",
    "magic-string": "^1.4.3",
    "nitropack": "^2.13.4",
    "oxc-parser": "^0.154.0",
    "prettier": "^3.9.10",
    "sirv": "^3.0.2",
    "ufo": "^1.6.4",
    "unplugin": "^3.4.0",
    "unstorage": "^1.17.6",
    "valibot": "^1.5.0",
    "vite-plugin-vue-tracer": "^1.6.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.3",
    "@nuxt/devtools-ui-kit": "^3.4.3",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/hints": "workspace:^",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.1",
    "@nuxt/test-utils": "^4.3.3",
    "@shikijs/transformers": "^4.5.0",
    "@types/node": "^24.19.2",
    "@vue/test-utils": "^2.5.1",
    "changelogen": "^0.6.2",
    "diff": "^9.0.0",
    "eslint": "^10.12.0",
    "get-port-please": "^3.2.0",
    "happy-dom": "^21.0.4",
    "nuxt": "^4.6.1",
    "pkg-pr-new": "0.0.91",
    "rimraf": "^6.1.3",
    "sass-embedded": "^1.105.2",
    "shiki": "^4.5.0",
    "shiki-transformer-fold": "^0.2.0",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd"
}
